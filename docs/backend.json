
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a professional on the network, searchable by others for coordination.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (Firebase UID)."
        },
        "email": {
          "type": "string",
          "description": "User's professional email.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "Unique username used for tagging and shift delivery."
        },
        "bio": {
          "type": "string",
          "description": "Professional summary or role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "A shift or coordination entry pushed to a professional's schedule.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner of the schedule."
        },
        "title": {
          "type": "string",
          "description": "Task or meeting name."
        },
        "type": {
          "type": "string",
          "enum": [
            "meeting",
            "shift"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "senderId": {
          "type": "string",
          "description": "Who dispatched this shift."
        },
        "senderName": {
          "type": "string",
          "description": "Name of the dispatcher."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "type",
        "date",
        "startTime",
        "endTime",
        "createdAt"
      ]
    },
    "Group": {
      "title": "Group",
      "description": "A professional team or department group.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "ownerId"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message sent within a group chat, supporting text and social media (images/videos).",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string", "description": "Optional URL for shared image or video." },
        "mediaType": { "type": "string", "enum": ["image", "video"], "description": "Type of media attached." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "createdAt"]
    },
    "Connection": {
      "title": "Connection",
      "description": "A professional following relationship.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "targetName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Public professional profile."
    },
    "/users/{userId}/meetings/{meetingId}": {
      "schema": {
        "$ref": "#/backend/entities/Meeting"
      },
      "description": "Personal schedule feed and incoming requests."
    },
    "/users/{userId}/following/{followedUserId}": {
      "schema": {
        "$ref": "#/backend/entities/Connection"
      },
      "description": "List of colleagues followed for coordination."
    },
    "/groups/{groupId}": {
      "schema": {
        "$ref": "#/backend/entities/Group"
      },
      "description": "Team group metadata."
    },
    "/groups/{groupId}/members/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["owner", "member"] }
        }
      },
      "description": "Group membership list."
    },
    "/groups/{groupId}/meetings/{meetingId}": {
      "schema": {
        "$ref": "#/backend/entities/Meeting"
      },
      "description": "Shared group schedule."
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/backend/entities/ChatMessage"
      },
      "description": "Real-time group chat messages."
    }
  }
}
