{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (Firebase UID)."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "User's unique username for identification."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Represents a meeting or shift in the schedule.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the schedule owner."
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "employeeName": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "emails": {
          "type": "string"
        },
        "attachments": {
          "type": "string"
        },
        "senderId": {
          "type": "string"
        },
        "senderName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "type",
        "date",
        "startTime",
        "endTime",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "User profile document."
    },
    "/users/{userId}/meetings/{meetingId}": {
      "schema": {
        "$ref": "#/backend/entities/Meeting"
      },
      "description": "User's individual schedule entries."
    }
  }
}