
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user's professional profile for discovery and networking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (Firebase UID)."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "description": "Unique username used for tagging and delivery."
        },
        "bio": {
          "type": "string",
          "description": "Brief professional summary."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Represents a shift or meeting entry delivered to a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner of the schedule entry."
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "meeting",
            "shift"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "startTime": {
          "type": "string"
        },
        "endTime": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "senderId": {
          "type": "string"
        },
        "senderName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "title",
        "type",
        "date",
        "startTime",
        "endTime",
        "createdAt"
      ]
    },
    "Connection": {
      "title": "Connection",
      "description": "Represents a professional follow relationship.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The user following."
        },
        "targetId": {
          "type": "string",
          "description": "The user being followed."
        },
        "targetName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Public user profile."
    },
    "/users/{userId}/meetings/{meetingId}": {
      "schema": {
        "$ref": "#/backend/entities/Meeting"
      },
      "description": "Private schedule feed and incoming requests."
    },
    "/users/{userId}/following/{followedUserId}": {
      "schema": {
        "$ref": "#/backend/entities/Connection"
      },
      "description": "User's professional network."
    }
  }
}
