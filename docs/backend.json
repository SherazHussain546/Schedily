
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a professional on the network, searchable by others for coordination.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "createdAt", "updatedAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "A shift or coordination entry pushed to a professional's schedule.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["meeting", "shift"] },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "description": { "type": "string" },
        "attachments": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "type", "date", "startTime", "endTime", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A record of an AI-generated email sent to the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["message", "shift", "meeting", "invitation"] },
        "senderName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subject", "body", "type", "createdAt"]
    },
    "Group": {
      "title": "Group",
      "description": "A professional team or department group.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message sent within a group chat, supporting text and social media.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "createdAt"]
    },
    "Membership": {
      "title": "Membership",
      "description": "Inverse tracking for groups a user has joined.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "groupName": { "type": "string" },
        "role": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      }
    },
    "FollowConnection": {
      "title": "FollowConnection",
      "description": "Tracking for professional network connections.",
      "type": "object",
      "properties": {
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "followerId": { "type": "string" },
        "followerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Public professional profile."
    },
    "/users/{userId}/meetings/{meetingId}": {
      "schema": { "$ref": "#/backend/entities/Meeting" },
      "description": "Personal schedule feed."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/backend/entities/Notification" },
      "description": "Inbox for AI-generated coordination emails."
    },
    "/users/{userId}/memberships/{groupId}": {
      "schema": { "$ref": "#/backend/entities/Membership" },
      "description": "List of groups the user is involved in."
    },
    "/users/{userId}/following/{followedUserId}": {
      "schema": { "$ref": "#/backend/entities/FollowConnection" },
      "description": "People this professional is following."
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": { "$ref": "#/backend/entities/FollowConnection" },
      "description": "Network of colleagues following this user."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/backend/entities/Group" },
      "description": "Team group metadata."
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": { "$ref": "#/backend/entities/ChatMessage" },
      "description": "Real-time group chat."
    }
  }
}
