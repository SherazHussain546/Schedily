rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. USER PROFILES
    // Allows discovery: Managers can find employees by searching for their username.
    // Profiles are writable only by the owner during signup/update.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. USER SCHEDULE (MEETINGS & SHIFTS)
    // This subcollection holds the private entries for each user.
    match /users/{userId}/meetings/{meetingId} {
      
      // OWNER ACCESS: 
      // If the userId in the path matches the authenticated UID, grant full control.
      // Explicitly allows 'list' (collection queries) and 'get' (single items).
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      
      // DELIVERY ACCESS (THE "PUSH" MODEL):
      // Allows ANY authenticated user (e.g., a Manager) to CREATE a new entry.
      // This is like a one-way mailbox slot: they can drop things in, but can't see the contents.
      allow create: if request.auth != null;
    }
  }
}