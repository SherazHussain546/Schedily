
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROFESSIONAL PROFILES
    // Publicly searchable profiles for social coordination.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // THE SOCIAL MAILBOX (MEETINGS & SHIFTS)
      // We explicitly split list/get to ensure queries are authorized correctly.
      match /meetings/{meetingId} {
        // Owner has full access to their feed.
        allow list, get, update, delete: if request.auth != null && request.auth.uid == userId;
        // Anyone can "Push" a shift/meeting to this user's mailbox.
        allow create: if request.auth != null;
      }

      // CONNECTIONS (FOLLOWING)
      match /following/{followedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
