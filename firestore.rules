rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. USER PROFILES
    // Everyone can find users by username; only the owner can edit their profile.
    match /users/{userId} {
      allow get, list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. MEETINGS / SHIFTS (The Mailbox Pattern)
    match /users/{userId}/meetings/{meetingId} {
      
      // OWNERS: Full control over their own schedule.
      // This allows the "list" method (queries) to work for the authenticated owner.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // MANAGERS: Can "Deliver" (Create) a meeting to another user.
      // They cannot read, list, or update documents they didn't push.
      allow create: if request.auth != null 
        && request.resource.data.senderId == request.auth.uid;
    }
  }
}