
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROFESSIONAL PROFILES
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /meetings/{meetingId} {
        allow create: if request.auth != null;
      }
    }

    // PROFESSIONAL GROUPS
    match /groups/{groupId} {
      function isMember() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      
      function isOwner() {
        return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';
      }

      allow read: if request.auth != null && isMember();
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();

      match /members/{memberId} {
        allow read: if request.auth != null && isMember();
        allow write: if request.auth != null && (isOwner() || request.auth.uid == memberId);
      }

      match /meetings/{meetingId} {
        allow read: if request.auth != null && isMember();
        allow create, update, delete: if request.auth != null && isMember();
      }
    }
  }
}
