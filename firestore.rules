rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Rules
    // Profiles are readable by all authenticated users to allow finding managers/employees by username
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Meetings & Shifts Subcollection
      // This rule explicitly allows the owner to GET and LIST (query) their own entries.
      match /meetings/{meetingId} {
        // 1. Owner access: Full permissions for everything in their own path.
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // 2. Delivery access: Allows another user to "Push" a document to this collection.
        // They can ONLY create; they cannot read or list existing meetings.
        // They must provide their own UID as the senderId for accountability.
        allow create: if request.auth != null && 
          request.resource.data.senderId != null && 
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}