
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PUBLIC DISCOVERY: Anyone can find profiles to follow them
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // MASTER KEY: The owner has full access to list/read/write everything in their folder
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // MAILBOX: Allows others to push a meeting to this user
      match /meetings/{meetingId} {
        allow create: if request.auth != null;
      }
      
      // NETWORK: Users can follow others
      match /following/{followedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
