rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. RECURSIVE OWNERSHIP (The Master Key)
    // If the path matches the authenticated user's ID, they have full access to everything underneath.
    // This allows for complex queries and listing of subcollections (like meetings).
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. PROFILE DISCOVERY
    // Allows any authenticated user to search/read profile documents.
    // This is necessary so Managers can find an Employee's UID using their Username.
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // 3. MAILBOX PUSH (Delivery Access)
    // Allows any authenticated user to CREATE a document in another user's meetings collection.
    // This is the "Push" model where managers drop shifts into an employee's mailbox.
    match /users/{userId}/meetings/{meetingId} {
      allow create: if request.auth != null;
    }
  }
}