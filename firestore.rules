
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Publicly readable for network discovery, but only editable by the owner.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Meetings Subcollection: Core scheduling logic.
      match /meetings/{meetingId} {
        // 1. The Owner has "Master Key" access (List, Get, Create, Update, Delete).
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // 2. The "Mailbox Slot": Managers/Teammates can ONLY create new entries (push shifts).
        // They cannot list, get, or modify existing data in this folder.
        allow create: if request.auth != null && request.auth.uid != userId;
      }

      // Following Subcollection: Personal networking connections.
      match /following/{followedUserId} {
        // Only the owner can manage who they are following.
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
