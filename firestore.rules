rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    // Allows any signed-in user to read profiles (needed for username search).
    // Only the owner can write to their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Meetings and Shifts Subcollection
      // Explicitly match the subcollection to ensure 'list' operations are permitted for the owner.
      match /meetings/{meetingId} {
        // The owner has full read access (get and list).
        allow read: if request.auth != null && request.auth.uid == userId;
        
        // Ownership check for updates and deletions.
        allow update, delete: if request.auth != null && request.auth.uid == userId;
        
        // Creation permissions:
        // 1. The owner can create their own entries.
        // 2. Any user can create an entry in another user's collection if they are sharing (identifying as sender).
        allow create: if request.auth != null && (
          request.auth.uid == userId || 
          request.resource.data.senderId == request.auth.uid
        );
      }
    }
  }
}