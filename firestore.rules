
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROFESSIONAL PROFILES
    // Profiles are searchable by all authenticated professionals.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // THE SOCIAL MAILBOX (MEETINGS & SHIFTS)
      // 1. Owner Access: Total control over their own schedule feed.
      // 2. Teammate Delivery: Any professional can 'CREATE' (Deliver) a shift to this mailbox.
      match /meetings/{meetingId} {
        allow list, get, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }

      // PROFESSIONAL CONNECTIONS (FOLLOWING)
      match /following/{followedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
