
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. PUBLIC DIRECTORY
    // Allows any logged-in user to find a colleague by username to deliver shifts.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. RECURSIVE OWNERSHIP (The Master Key)
    // This allows the owner to perform any operation (including LIST/queries) 
    // on any sub-collection within their own user folder.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. THE DELIVERY SLOT (The Mailbox)
    // This allows Managers to "drop off" new meetings in an employee's folder.
    // They cannot read existing items or list the folder.
    match /users/{userId}/meetings/{meetingId} {
      allow create: if request.auth != null;
    }
  }
}
