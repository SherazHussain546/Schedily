rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. RECURSIVE OWNER ACCESS
    // If a document or subcollection is under /users/{userId}/, the owner has full control.
    // Using {allPaths=**} ensures that 'list' (queries) on subcollections are always authorized for the owner.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. PROFILE SEARCH LOOKUP
    // Allows managers to find employees by username. 
    // This allows get (by ID) and list (querying by username) for all authenticated users.
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // 3. MANAGER "PUSH" PERMISSION
    // Allows a manager to create a document in an employee's meeting list.
    // They can ONLY 'create'; they cannot read, edit, or delete existing entries.
    // They must identify themselves as the sender for accountability.
    match /users/{userId}/meetings/{meetingId} {
      allow create: if request.auth != null && 
        request.resource.data.senderId != null && 
        request.resource.data.senderId == request.auth.uid;
    }
  }
}