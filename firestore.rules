
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROFESSIONAL PROFILES
    // Profiles are searchable by all authenticated professionals to build their network.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // THE SOCIAL MAILBOX (MEETINGS & SHIFTS)
    // 1. Owner Access: Full control over their own schedule feed (listing, reading, managing).
    // 2. Teammate Delivery: Any authenticated professional can 'CREATE' (Deliver) a shift to this mailbox.
    match /users/{userId}/meetings/{meetingId} {
      allow get, list, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // PROFESSIONAL CONNECTIONS (FOLLOWING)
    // Users manage their own list of colleagues they coordinate with.
    match /users/{userId}/following/{followedUserId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
