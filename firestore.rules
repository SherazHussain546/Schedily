rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. OWNER ACCESS
    // Grant full recursive access to the owner of a user folder.
    // Using {document=**} ensures that 'list' queries on sub-collections like 'meetings' 
    // are automatically authorized for the owner.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. PUBLIC PROFILES
    // Allows any authenticated user to search the directory (e.g. by username) 
    // to find colleagues and deliver shifts.
    match /users/{userId} {
      allow read: if request.auth != null;
    }

    // 3. DELIVERY SLOT
    // Allows managers to "push" a new entry to an employee's schedule.
    // They can drop it off (create), but they cannot see the employee's existing schedule.
    match /users/{userId}/meetings/{meetingId} {
      allow create: if request.auth != null;
    }
  }
}