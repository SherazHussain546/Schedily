rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. USER FOLDER ACCESS (Simple & Robust)
    // If your UID matches the folder ID, you have full access to everything inside.
    // The recursive wildcard {document=**} covers subcollections like /meetings automatically.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. MANAGER "PUSH" PERMISSION (The Mailbox)
    // Allows a third party (Manager) to 'create' a document in an employee's folder.
    // They cannot read, list, or edit existing data; they can only "drop off" new shifts.
    match /users/{userId}/meetings/{meetingId} {
      allow create: if request.auth != null && 
        request.resource.data.senderId != null && 
        request.resource.data.senderId == request.auth.uid;
    }

    // 3. PUBLIC DIRECTORY (Read-Only)
    // Allows any authenticated user to look up another user's profile to get their UID.
    // This is required for the "Delivery" feature to find employees by username.
    match /users/{userId} {
      allow read: if request.auth != null;
    }
  }
}