
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. PUBLIC PROFILES
    // Needed so managers can find employee IDs by searching for their username.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. THE MAILBOX (Meetings)
    match /users/{userId}/meetings/{meetingId} {
      
      // FULL ACCESS for the Owner of the schedule.
      // This explicitly allows 'list' operations (queries) for the owner.
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // DELIVERY SLOT: Any authenticated user can "drop off" a meeting/shift.
      // They cannot see the folder contents, only add to it.
      allow create: if request.auth != null;
    }
  }
}
