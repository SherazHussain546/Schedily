
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Users can see other profiles to enable the sharing/lookup feature
      allow get, list: if isSignedIn(); 
      // Only the user can create or update their own profile
      allow create, update: if isOwner(userId);

      match /meetings/{meetingId} {
        // Owners have full access to their own meetings
        allow read, write: if isOwner(userId);
        
        // Allow creating a meeting in another user's collection if it's a shared "invite"
        // The senderId must match the authenticated user's UID
        allow create: if isSignedIn() && 
                      (isOwner(userId) || request.resource.data.senderId == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
