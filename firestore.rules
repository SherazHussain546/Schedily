
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROFESSIONAL PROFILES & SOCIAL FEED
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Personal Schedule & Mailbox
      match /meetings/{meetingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }

      // AI Notification Log (Inbox)
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow anyone authenticated to 'send' a notification to this user's log
        allow create: if request.auth != null;
      }

      match /following/{followedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /memberships/{groupId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null;
      }

      match /followers/{followerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == followerId;
      }
    }

    // PROFESSIONAL GROUPS
    match /groups/{groupId} {
      function isMember() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      
      function isOwner() {
        return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';
      }

      allow get, list: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isOwner();

      match /members/{memberId} {
        allow read: if request.auth != null && isMember();
        allow write: if request.auth != null && (isOwner() || request.auth.uid == memberId);
      }

      match /meetings/{meetingId} {
        allow read: if request.auth != null && isMember();
        allow create, update, delete: if request.auth != null && isMember();
      }

      match /messages/{messageId} {
        allow read, create: if request.auth != null && isMember();
      }
    }
  }
}
