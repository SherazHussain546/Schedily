
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // USER PROFILE RULES
    // ------------------
    // Profiles are publicly readable for network discovery (search by username).
    // Only the owner can edit their own profile data.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // MASTER KEY FOR OWNERS
      // ---------------------
      // This recursive wildcard ensures that the owner has full permission 
      // to LIST, GET, and MANAGE everything inside their private folder.
      // This is the primary fix for the "Insufficient Permissions" on 'list' operations.
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // THE "MAILBOX" SLOT
      // ------------------
      // Allows Managers or Teammates to "PUSH" (create) a shift/meeting entry 
      // into this user's schedule folder. They cannot list, read, or edit existing data.
      // This facilitates the "Deliver Shift" functionality.
      match /meetings/{meetingId} {
        allow create: if request.auth != null && request.auth.uid != userId;
      }
    }
  }
}
