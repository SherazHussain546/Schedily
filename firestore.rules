rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Rules
    match /users/{userId} {
      // Any authenticated user can read profiles (for sharing/search)
      allow read: if request.auth != null;
      // Only the owner can write to their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Meetings and Shifts Rules
    // Using a flat match ensures explicit collection listing permissions are granted to the owner.
    match /users/{userId}/meetings/{meetingId} {
      // The owner has full read (get/list) and write access to their own entries
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Peer-to-Peer Sharing:
      // Any authenticated user can create a meeting in another user's collection 
      // IF they provide their own UID as the senderId.
      allow create: if request.auth != null && 
        request.resource.data.senderId != null && 
        request.resource.data.senderId == request.auth.uid;
    }
  }
}