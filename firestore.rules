
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PROFESSIONAL PROFILES
    // Publicly searchable profiles for social coordination.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // RECURSIVE OWNERSHIP (THE MASTER KEY)
      // This grants the owner total authority to list and manage anything in their folder.
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // SOCIAL MAILBOX (DROP-OFF SLOT)
      // Allows anyone in the network to "Push" a shift/meeting to this user.
      match /meetings/{meetingId} {
        allow create: if request.auth != null;
      }
    }
  }
}
