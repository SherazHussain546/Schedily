
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Allow profile reading for search/lookup functionality
      allow read: if isSignedIn();
      
      // Only the user can manage their own profile metadata
      allow create, update: if isOwner(userId);

      match /meetings/{meetingId} {
        // Owners have full access to their own meetings collection and documents
        allow read, update, delete: if isOwner(userId);
        
        // Allow creation if the user is the owner OR if another user is sending an invite
        // We verify senderId matches the actual authenticated user to prevent spoofing
        allow create: if isSignedIn() && (
          request.auth.uid == userId || 
          (request.resource.data.senderId == request.auth.uid)
        );
      }
    }
  }
}
