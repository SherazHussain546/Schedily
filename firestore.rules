rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Rules
    match /users/{userId} {
      // Any authenticated user can read profiles (for sharing/search)
      allow read: if request.auth != null;
      // Only the owner can write to their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // Meetings and Shifts Rules
      // We match the documents within the collection to provide both individual (get) 
      // and collection-wide (list) access.
      match /meetings/{meetingId} {
        // The owner has full read and write access to their own entries
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Peer-to-Peer Sharing:
        // Any authenticated user can create a meeting in another user's collection 
        // IF they provide their own UID as the senderId.
        allow create: if request.auth != null && (
          request.auth.uid == userId || 
          (request.resource.data.senderId != null && request.resource.data.senderId == request.auth.uid)
        );
      }
    }
  }
}