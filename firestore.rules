
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // USER PROFILES
    // -------------
    // Profiles are public so users can find colleagues to follow or tag.
    // Only the owner can edit their own profile info.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // MEETINGS & SHIFTS
      // -----------------
      // Owner: Full access to list their schedule and manage entries.
      // Peers: Can "CREATE" (Push/Deliver) a new entry into this folder.
      match /meetings/{meetingId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
      }

      // SOCIAL NETWORK (FOLLOWING)
      // --------------------------
      // Only the owner manages who they are following.
      match /following/{followedUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
