rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Rules
    // Profiles are readable by authenticated users so managers can find employees by username
    // Owners can create/update their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Meetings and Shifts Subcollection - Flattened for robust 'list' operations
    // Rule 1: The owner of the path has full access (read includes get and list)
    // Rule 2: A Manager can "Push" a meeting to any user's schedule (create only)
    match /users/{userId}/meetings/{meetingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      allow create: if request.auth != null && 
        request.resource.data.senderId != null && 
        request.resource.data.senderId == request.auth.uid;
    }
  }
}