
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Allow searching for users by username (list) for sharing
      allow get, list: if isSignedIn(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      match /meetings/{meetingId} {
        allow get, list, update, delete: if isOwner(userId);
        
        // Allow creating a meeting in another user's collection if it's an "invite"
        // Condition: The document must have a 'senderId' matching the requester.
        allow create: if isSignedIn() && 
                      (isOwner(userId) || request.resource.data.senderId == request.auth.uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
