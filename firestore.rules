
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // USER PROFILES
    // -------------
    // Profiles are readable by all authenticated professionals for discovery.
    // Only the owner can manage their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // MEETINGS & SHIFTS (THE SOCIAL MAILBOX)
    // --------------------------------------
    // 1. Owner: Full access to list their feed, accept requests, and manage entries.
    // 2. Teammates: Can 'CREATE' (Deliver) a new entry to this mailbox.
    match /users/{userId}/meetings/{meetingId} {
      allow list, get, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // SOCIAL CONNECTIONS (FOLLOWING)
    // ------------------------------
    // Users manage their own professional network connections.
    match /users/{userId}/following/{followedUserId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
