rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Rules
    // Profiles are readable by authenticated users so they can find each other by username
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Meetings Subcollection
      // Nested matches ensure that the {userId} variable is consistently applied.
      match /meetings/{meetingId} {
        // 1. Owner Access: If you are the owner of this path, you have full control.
        // This explicitly covers 'list' (queries), 'get', and all 'write' operations.
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // 2. Manager Delivery: Allow other users to "Push" a new meeting to this user.
        // They can ONLY create; they cannot read existing entries or modify them.
        allow create: if request.auth != null && 
          request.resource.data.senderId != null && 
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}