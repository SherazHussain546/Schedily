
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      // Allow profile reading for all signed-in users (required for sharing search)
      allow read: if request.auth != null;
      
      // Only the authenticated user can create or update their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // Meetings and Shifts Subcollection
      match /meetings/{meetingId} {
        // The owner of the collection has full access to read, create, update, and delete
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Special rule for peer-to-peer sharing:
        // Allow ANY signed-in user to CREATE a document in another user's collection
        // as long as the 'senderId' in the document matches their own UID.
        allow create: if request.auth != null && 
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
