# GENAI SECRETS (SERVER-SIDE ONLY)
# Replace with your actual Gemini API Key. 
# DO NOT commit the .env file with this key to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here

# FIREBASE CONFIG (PUBLICLY SAFE)
# These are used as fallbacks if environment variables aren't detected.
# They are public by design and secured via Firestore Security Rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
